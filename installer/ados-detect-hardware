#!/bin/sh
set -eu
DT=/proc/device-tree
read_dt() { [ -r "$1" ] || return 0; tr '\000' '\n' < "$1"; }
MODEL="$(read_dt "$DT/model" | head -n1)"
COMPAT="$(read_dt "$DT/compatible" | tr '\n' ' ')"
REVISION="$(awk -F': ' '/^Revision[[:space:]]*:/ {print $2}' /proc/cpuinfo 2>/dev/null | tail -n1 || true)"
SOC=unknown
case "$COMPAT $MODEL" in *bcm2711*) SOC=bcm2711 ;; *bcm2837*) SOC=bcm2837-family ;; esac
BOARD=unknown
case "$MODEL" in *"Raspberry Pi 4 Model B"*) BOARD=rpi4 ;; *"Raspberry Pi 3 Model B Plus"*|*"Raspberry Pi 3 Model B+"*) BOARD=rpi3bplus ;; *"Raspberry Pi 3 Model B"*) BOARD=rpi3b ;; esac
SOC_REVISION="${ADOS_SOC_REVISION:-}"
if [ -z "$SOC_REVISION" ]; then
  for f in "$DT/soc/revision" "$DT/system/linux,revision"; do
    if [ -r "$f" ]; then SOC_REVISION="$(od -An -tx4 "$f" 2>/dev/null | tr -d ' \n' || true)"; [ -n "$SOC_REVISION" ] && break; fi
  done
fi
PROFILE="$BOARD"
if [ "$BOARD" = rpi3b ]; then case "$SOC_REVISION" in *b0*|*B0*) PROFILE=rpi3-frankenstein ;; esac; fi
case "$PROFILE" in rpi3b|rpi3-frankenstein|rpi3bplus|rpi4) ;; *) echo "ERROR: unsupported or ambiguous Raspberry Pi hardware" >&2; echo "model=$MODEL" >&2; echo "compatible=$COMPAT" >&2; echo "revision=$REVISION" >&2; echo "soc_revision=$SOC_REVISION" >&2; exit 1 ;; esac
printf 'profile=%s\nboard=%s\nsoc=%s\nmodel=%s\nrevision=%s\nsoc_revision=%s\n' "$PROFILE" "$BOARD" "$SOC" "$MODEL" "$REVISION" "$SOC_REVISION"
