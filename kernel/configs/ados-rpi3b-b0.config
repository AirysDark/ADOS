# ADOS Raspberry Pi 3B + BCM2837B0 compatibility target
# Keep Pi 3B board assumptions while ensuring the kernel retains the
# BCM2837/B0 platform, CPU frequency, thermal and VideoCore support.
CONFIG_ARCH_BCM2835=y
CONFIG_ARM_RASPBERRYPI_CPUFREQ=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_BCM2835_THERMAL=y
CONFIG_DRM=y
CONFIG_DRM_V3D=y
CONFIG_V3D=y
