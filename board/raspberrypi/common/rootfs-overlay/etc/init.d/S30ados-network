#!/bin/sh
CONF=/etc/ados/network.conf
[ -r "$CONF" ] && . "$CONF"
ETHERNET_INTERFACE="${ETHERNET_INTERFACE:-eth0}"
WIFI_INTERFACE="${WIFI_INTERFACE:-wlan0}"
PORTABLE_INTERFACE="${PORTABLE_INTERFACE:-ados0}"
PIDDIR=/run/ados/network

start_dhcp() {
  iface="$1"
  [ "$iface" = "$PORTABLE_INTERFACE" ] && return 0
  ip link show "$iface" >/dev/null 2>&1 || return 0
  ip link set "$iface" up 2>/dev/null || true
  if command -v udhcpc >/dev/null 2>&1; then
    udhcpc -b -p "$PIDDIR/udhcpc-$iface.pid" -i "$iface" >/dev/null 2>&1 || true
  fi
}

start() {
  mkdir -p "$PIDDIR"
  rfkill unblock wifi 2>/dev/null || true
  start_dhcp "$ETHERNET_INTERFACE"
  # wlan0 remains the normal station interface. Portable owns only ados0.
  if ip link show "$WIFI_INTERFACE" >/dev/null 2>&1; then
    ip link set "$WIFI_INTERFACE" up 2>/dev/null || true
    if [ -s /etc/wpa_supplicant.conf ] && command -v wpa_supplicant >/dev/null 2>&1; then
      wpa_supplicant -B -P "$PIDDIR/wpa_supplicant.pid" -i "$WIFI_INTERFACE" -c /etc/wpa_supplicant.conf >/dev/null 2>&1 || true
      start_dhcp "$WIFI_INTERFACE"
    fi
  fi
}
stop() {
  for p in "$PIDDIR"/*.pid; do
    [ -f "$p" ] || continue
    kill "$(cat "$p")" 2>/dev/null || true
    rm -f "$p"
  done
  # Never delete or reconfigure ados0 here. It belongs to ADOS Portable.
}
case "$1" in
 start) start ;;
 stop) stop ;;
 restart) stop; sleep 1; start ;;
 *) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
